# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# --- Contact form ---
# Every submission is always saved to a local database at
# data/contact-submissions.db regardless of whether the vars below
# are set — that's the durable source of truth so leads are never
# lost. The vars below only control the *bonus* email notification.

# Web3Forms (https://web3forms.com) sends contact-form submissions by
# email — no signup or domain verification needed on the free tier:
# go to web3forms.com, enter info@ctrlaz.com, and they'll email you an
# access key instantly. Paste it below.
#
# NEXT_PUBLIC_ is required (not optional) here: Web3Forms' free tier
# only accepts submissions sent directly from the browser, not from
# our server, so this call happens client-side and Next.js only
# bundles env vars into client code when they're NEXT_PUBLIC_-
# prefixed. This is safe — Web3Forms access keys are meant to be
# public and can be domain-restricted in their dashboard, unlike a
# real secret API key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Pick any long random string. Visit /admin/submissions?token=<this>
# to view stored contact-form leads. Leave blank to disable that page
# entirely (it 404s if this isn't set).
ADMIN_ACCESS_TOKEN=
