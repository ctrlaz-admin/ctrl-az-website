# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# --- Contact form ---
# Every submission is always saved to a local database at
# data/contact-submissions.db regardless of whether the vars below
# are set — that's the durable source of truth so leads are never
# lost. The vars below only control the *bonus* email notification.

# Web3Forms (https://web3forms.com) sends contact-form submissions by
# email — no domain verification needed. Sign up, create an access
# key, and set its notification email to info@ctrlaz.com in the
# web3forms.com dashboard. Paste the access key below.
WEB3FORMS_ACCESS_KEY=

# Pick any long random string. Visit /admin/submissions?token=<this>
# to view stored contact-form leads. Leave blank to disable that page
# entirely (it 404s if this isn't set).
ADMIN_ACCESS_TOKEN=
