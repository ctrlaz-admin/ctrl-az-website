# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# --- Contact form ---
# Every submission is always saved to a local database at
# data/contact-submissions.db regardless of whether the vars below
# are set — that's the durable source of truth so leads are never
# lost. The vars below only control the *bonus* email notification.

# Resend (https://resend.com) is used to send contact-form submissions
# to info@ctrlaz.com. Sign up, verify the ctrlaz.com domain (or use
# their onboarding@resend.dev sender for testing), and paste the API
# key below.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account,
# e.g. website@ctrlaz.com. Used as the "From" address on outgoing
# contact-form emails; replies go to the visitor's own email.
CONTACT_FROM_EMAIL=

# Pick any long random string. Visit /admin/submissions?token=<this>
# to view stored contact-form leads. Leave blank to disable that page
# entirely (it 404s if this isn't set).
ADMIN_ACCESS_TOKEN=
